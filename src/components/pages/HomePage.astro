---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations } from "@/i18n/utils";
import type { Locale } from "@/i18n/config";
import LocaleSwitcher from "@/components/LocaleSwitcher.astro";
import { getProjects, getProjectStats } from "@/lib/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
const stats = await getProjectStats(locale);
---

<BaseLayout title={t("home.title")} description={t("home.meta.description")} locale={locale}>
  <section class="hero-gradient min-h-screen">
    <div class="container-page py-24">
      <LocaleSwitcher locale={locale} />
      <p class="font-mono text-sm tracking-widest text-accent uppercase">
        {t("home.role")}
      </p>
      <h1 class="mt-6 font-display text-6xl font-bold text-text">
        {t("home.title")}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-text-muted">
        {t("home.tagline")}
      </p>
      <p class="mt-12 font-mono text-sm text-text-muted">
        {stats.projectCount} projects · {stats.techCount} technologies · {stats.latestYear}
      </p>

      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {
          projects.map((project) => (
            <li class="rounded-lg border border-border bg-surface-raised p-5">
              <p class="font-mono text-xs text-text-muted">
                {project.year} · {project.category}
              </p>
              <h2 class="mt-2 font-display text-xl font-bold text-text">{project.title}</h2>
              <p class="mt-2 text-sm text-text-muted">{project.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {project.tech.slice(0, 6).map((tech) => (
                  <li class="rounded border border-border px-2 py-0.5 font-mono text-[11px] text-text-muted">
                    {tech}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
