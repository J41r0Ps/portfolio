---
/**
 * HomePage.
 *
 * Every number on this page is derived from the content collections at
 * build time — nothing is hardcoded, so adding a project updates the stat
 * strip, the skills section and the featured grid in all three languages
 * at once.
 *
 * JavaScript: none below 1024px. On desktop, only the 3D hero, which
 * hydrates through client:media and loads three.js as a separate chunk.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Button from "@/components/ui/Button.astro";
import Chip from "@/components/ui/Chip.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import HeroScene from "@/components/three/HeroScene";

import { CV_FILES, type Locale } from "@/i18n/config";
import { localizePath, useTranslations } from "@/i18n/utils";
import { getFeaturedProjects, getProjectStats } from "@/lib/projects";
import { getSkillGroups } from "@/lib/skills";

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const t = useTranslations(locale);

const [featured, stats, skillGroups] = await Promise.all([
  getFeaturedProjects(locale, 3),
  getProjectStats(locale),
  getSkillGroups(locale),
]);

/* --------------------------------------------------------------------
   STATIC TERRAIN FRAME — optional asset

   A frozen frame of the 3D terrain, captured in dev with Alt+P (see
   DevHelpers.tsx) and saved as src/assets/hero/terrain-mask.png.

   Why import.meta.glob instead of a normal `import`:
   a normal import of a file that does not exist breaks the build. The
   glob simply returns an empty object when nothing matches, so the page
   builds before the frame has been captured, and picks it up the moment
   the file appears. No code change needed after capturing.

   `eager: true` loads it at build time rather than as a lazy function,
   and Astro turns the image into a fingerprinted URL for cache-busting.
   -------------------------------------------------------------------- */
const maskModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/hero/terrain-mask.{png,webp}",
  { eager: true },
);

const terrainMask = Object.values(maskModules)[0]?.default;

/**
 * The URL is handed to CSS as a custom property, so the .terrain-static
 * rule in global.css can use it as a mask. Undefined → no style, and the
 * static layers below are not rendered at all.
 */
const heroStyle = terrainMask ? `--terrain-mask: url(${terrainMask.src})` : undefined;
---

<BaseLayout title={t("home.title")} description={t("home.meta.description")} locale={locale}>
  {
    /* ============================================================
      01 — HERO

      Three layers of the same terrain, used in different situations:

        mobile        faint static frame behind the text (no JS at all)
        desktop       static frame in the box, then the live WebGL
                      terrain fades in over it once the canvas is ready
        fallback      reduced motion / no WebGL / GPU context lost:
                      the static frame simply stays

      The box has its final dimensions before any script runs, so the
      canvas mounting later causes zero layout shift.
      ============================================================ */
  }
  <section class="hero-gradient relative overflow-hidden" style={heroStyle}>
    {
      /*
        MOBILE TERRAIN — below 1024px only.
        No canvas, no React, no layout cost: a CSS mask coloured with
        var(--accent), so it follows the theme. pointer-events-none so it
        never blocks taps on the buttons.
      */
      terrainMask && (
        <div
          aria-hidden="true"
          class="terrain-static pointer-events-none absolute inset-x-0 bottom-0 h-1/2 opacity-25 lg:hidden"
        />
      )
    }

    {
      /* `relative` is required: it creates a stacking context so the
         text paints above the absolutely positioned mobile layer. */
    }
    <div
      class="container-page relative grid items-center gap-12 py-15 lg:grid-cols-2 lg:gap-16 lg:py-10"
    >
      <div>
        <p class="enter font-mono text-sm tracking-widest text-accent uppercase">
          {t("home.role")}
        </p>

        {/* mask-line clips the inner span so the name rises into view. */}
        <h1
          class="mask-line mt-5 font-display text-5xl leading-[1.05] font-bold tracking-tight text-text sm:text-6xl xl:text-7xl"
        >
          <span>{t("home.title")}</span>
        </h1>

        <p
          class="enter mt-6 max-w-lg text-lg leading-relaxed text-text-muted"
          style="--delay: 150ms"
        >
          {t("home.tagline")}
        </p>

        <div class="enter mt-9 flex flex-wrap items-center gap-3" style="--delay: 250ms">
          <Button href={localizePath("/projects", locale)}>
            {t("home.hero.cta.work")}
          </Button>
          <Button href={localizePath("/contact", locale)} variant="secondary">
            {t("home.hero.cta.contact")}
          </Button>
          <Button href={CV_FILES[locale]} download variant="ghost">
            {t("cta.downloadCV")}
          </Button>
        </div>
      </div>

      {
        /*
          DESKTOP 3D BOX — hidden below lg, so phones never see an empty
          rectangle. aria-hidden: purely decorative.
        */
      }
      <div
        id="hero-visual"
        aria-hidden="true"
        class="relative mx-auto hidden aspect-square w-full max-w-md rounded-2xl border border-border
               bg-linear-to-br from-accent/10 via-transparent to-accent/5 lg:block lg:max-w-lg"
      >
        {/* Soft accent glow — the base layer, always present. */}
        <div
          class="absolute inset-0 rounded-2xl bg-[radial-gradient(circle_at_50%_40%,var(--accent),transparent_65%)] opacity-[0.18]"
        >
        </div>

        {
          /*
            STATIC FRAME — visible until the canvas sets data-live on
            #hero-visual, then cross-fades out (see global.css). If the
            canvas never starts, or loses its GPU context, it stays.
          */
          terrainMask && <div class="terrain-static absolute inset-0 rounded-2xl opacity-80" />
        }

        {
          /*
            LIVE TERRAIN — client:media only hydrates at ≥1024px. Below
            that width no hero JavaScript is requested at all, React
            included. HeroScene then decides internally whether to load
            three.js (reduced motion, WebGL support, context loss).
          */
        }
        <HeroScene client:only="react" />
      </div>
    </div>
  </section>

  {
    /* ============================================================
      STAT STRIP — derived, never typed by hand
      ============================================================ */
  }
  <section class="border-y border-border bg-surface-sunken">
    <div class="container-page grid grid-cols-3 divide-x divide-border">
      <div class="py-6 pr-4">
        <p class="font-display text-3xl font-bold text-text">{stats.projectCount}</p>
        <p class="mt-1 font-mono text-xs tracking-wide text-text-muted uppercase">
          {t("home.stats.projects")}
        </p>
      </div>
      <div class="py-6 pl-4 pr-4 sm:pl-6">
        <p class="font-display text-3xl font-bold text-text">{stats.techCount}</p>
        <p class="mt-1 font-mono text-xs tracking-wide text-text-muted uppercase">
          {t("home.stats.technologies")}
        </p>
      </div>
      <div class="py-6 pl-4 sm:pl-6">
        <p class="font-display text-3xl font-bold text-text">{stats.latestYear}</p>
        <p class="mt-1 font-mono text-xs tracking-wide text-text-muted uppercase">
          {t("home.stats.latest")}
        </p>
      </div>
    </div>
  </section>

  {
    /* ============================================================
      02 — SELECTED WORK
      ============================================================ */
  }
  <section class="container-page py-20 sm:py-28">
    <SectionHeader
      class="reveal"
      number={2}
      title={t("home.featured.title")}
      subtitle={t("home.featured.subtitle")}
    />

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((project) => (
          <li class="reveal flex">
            <ProjectCard project={project} locale={locale} as="h3" />
          </li>
        ))
      }
    </ul>

    <div class="mt-10">
      <Button href={localizePath("/projects", locale)} variant="secondary">
        {t("cta.viewAll")}
      </Button>
    </div>
  </section>

  {
    /* ============================================================
      03 — SKILLS

      Grouped, derived from project content. A technology cannot
      appear here without a project behind it.
      ============================================================ */
  }
  <section class="border-t border-border bg-surface-sunken">
    <div class="container-page py-20 sm:py-28">
      <SectionHeader
        class="reveal"
        number={3}
        title={t("home.skills.title")}
        subtitle={t("home.skills.subtitle")}
      />

      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          skillGroups.map((group) => (
            <div class="reveal">
              <h3 class="font-mono text-xs tracking-widest text-accent uppercase">{group.group}</h3>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <li>
                    <Chip count={item.count > 1 ? item.count : undefined}>{item.value}</Chip>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================================
      04 — ABOUT TEASER
      ============================================================ */
  }
  <section class="container-page py-20 sm:py-28">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <SectionHeader class="reveal" number={4} title={t("home.about.title")} />

      <div>
        <p class="text-lg leading-relaxed text-text-muted">
          {t("home.about.body")}
        </p>
        <div class="mt-7">
          <Button href={localizePath("/about", locale)} variant="secondary">
            {t("home.about.cta")}
          </Button>
        </div>
      </div>
    </div>
  </section>

  {
    /* ============================================================
      05 — CONTACT CTA
      ============================================================ */
  }
  <section class="border-t border-border">
    <div class="hero-gradient">
      <div class="container-page py-20 text-center sm:py-28">
        <h2 class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">
          {t("home.contact.title")}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-text-muted">
          {t("home.contact.body")}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href={localizePath("/contact", locale)}>
            {t("cta.getInTouch")}
          </Button>
          <Button href={CV_FILES[locale]} download variant="secondary">
            {t("cta.downloadCV")}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
