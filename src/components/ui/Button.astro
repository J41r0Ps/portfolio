---
/**
 * Button — the only button in the codebase.
 *
 * Polymorphic: pass `href` and it renders an <a>, omit it and you get a
 * <button>. That distinction matters for accessibility — a link that
 * navigates must be an anchor (right-click, middle-click, "open in new
 * tab" all depend on it), and an action that doesn't navigate must be a
 * button (keyboard activation differs).
 *
 * Variants live in a lookup object rather than a chain of ternaries, so
 * adding one is a single line and TypeScript enforces the set.
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost";
type Size = "sm" | "md";

interface Props extends Omit<HTMLAttributes<"a">, "size" | "type"> {
  variant?: Variant;
  size?: Size;
  href?: string;
  download?: boolean;
  external?: boolean;
  /** Only applies when rendering a <button> (no href). */
  type?: "button" | "submit" | "reset";
}

const {
  variant = "primary",
  size = "md",
  href,
  download = false,
  external = false,
  type = "button",
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md font-mono " +
  "transition-colors disabled:pointer-events-none disabled:opacity-50";

const variants: Record<Variant, string> = {
  primary: "bg-accent text-on-accent hover:bg-accent-hover",
  secondary: "border border-border-strong text-text hover:border-accent hover:text-accent",
  ghost: "text-text-muted hover:bg-surface-sunken hover:text-text",
};

const sizes: Record<Size, string> = {
  sm: "h-8 px-3 text-xs",
  md: "h-10 px-4 text-sm",
};

const classes = [base, variants[variant], sizes[size], className];

/**
 * `noopener` prevents the opened page from reaching back through
 * window.opener — a real security issue, not a formality.
 */
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a
      href={href}
      download={download || undefined}
      class:list={classes}
      {...externalAttrs}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
