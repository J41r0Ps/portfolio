---
/**
 * TimelineItem — one entry on the experience timeline.
 *
 * The vertical line and dot are drawn with borders and a positioned
 * pseudo-element rather than an SVG or a background image, so they
 * follow the theme tokens and cost nothing to render.
 */
import type { Locale } from '@/i18n/config';
import { formatRange, type ExperienceEntry } from '@/lib/experience';
import { useTranslations } from '@/i18n/utils';
import Chip from '@/components/ui/Chip.astro';

interface Props {
  item: ExperienceEntry;
  locale: Locale;
  /** Adds "(expected)" after the end date — used for the ongoing degree. */
  expected?: boolean;
}

const { item, locale, expected = false }: Props = Astro.props;
const t = useTranslations(locale);

const range = formatRange(item.start, item.end, locale, t('experience.present'));
const rangeLabel = expected ? `${range} (${t('experience.expected')})` : range;

/**
 * <time> with a machine-readable datetime is the correct element for a
 * date. It costs one attribute and makes the date parseable by anything
 * reading the page programmatically.
 */
const isoStart = item.start.toISOString().slice(0, 10);
---

<li class="relative border-l border-border pb-10 pl-6 last:pb-0">
  <span
    class="absolute -left-[4.5px] top-1.5 h-2 w-2 rounded-full bg-accent"
    aria-hidden="true"></span>

  <time datetime={isoStart} class="font-mono text-xs tracking-wide text-text-muted">
    {rangeLabel}
  </time>

  <h3 class="mt-2 font-display text-lg font-bold text-text">
    {item.title}
  </h3>

  <p class="mt-0.5 text-sm text-text-muted">
    {
      item.url ? (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent transition-colors hover:underline"
        >
          {item.organisation}
        </a>
      ) : (
        <span class="text-text">{item.organisation}</span>
      )
    }
    {item.location && <span> · {item.location}</span>}
  </p>

  {item.summary && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-text-muted">{item.summary}</p>}

  {
    item.highlights && item.highlights.length > 0 && (
      <ul class="mt-3 max-w-2xl space-y-1.5">
        {item.highlights.map((highlight) => (
          <li class="relative pl-4 text-sm leading-relaxed text-text-muted before:absolute before:left-0 before:text-accent before:content-['—']">
            {highlight}
          </li>
        ))}
      </ul>
    )
  }

  {
    item.tech && item.tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5">
        {item.tech.map((tech) => (
          <li>
            <Chip>{tech}</Chip>
          </li>
        ))}
      </ul>
    )
  }
</li>
